{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "index.html",
                    "styles.css",
                    "app.js",
                    "assets/**",
                    "config/**",
                    "controladores/**",
                    "modelos/**",
                    "Rutas/**",
                    "uploads/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/server.js"
        }
    ]
}
